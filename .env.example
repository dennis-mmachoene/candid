# Copy to .env.local and fill in. .env.local is git-ignored — keep it that way.
# Nothing in this file should ever hold a real value.

# --- Supabase (Phase 2) ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# The anon key is the only Supabase key that may appear in a user-facing path.
# It is subject to Row-Level Security, which is the whole point.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS entirely. Migrations and admin tasks only — never a
# user query. If you find this referenced in app/ or lib/infrastructure outside
# an explicit admin module, that is a bug, not a shortcut.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Phase 3) ---------------------------------------------------
ANTHROPIC_API_KEY=
# Pin a current model id from Anthropic's docs at build time. A Haiku-class
# model is enough for this workload.
ANTHROPIC_MODEL=

# --- Encryption (Phase 2) --------------------------------------------------
# 32 bytes, base64. Generate with:  openssl rand -base64 32
# Losing this makes every stored identity header unrecoverable, which is a
# feature from a breach standpoint and a problem from a backup standpoint.
ENCRYPTION_KEY=
