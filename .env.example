# Copy to .env.local and fill in. .env.local is git-ignored — keep it that way.
# Nothing in this file should ever hold a real value.

# --- Supabase --------------------------------------------------------------
# Project URL and keys: Dashboard → Connect, or Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key, starts with `sb_publishable_`. Safe in the browser: it is
# subject to Row-Level Security, which is the whole point.
#
# This replaces the older `anon` JWT key. Supabase deprecates the legacy anon
# and service_role keys at the end of 2026, so Candid uses the new names.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key, starts with `sb_secret_`. Bypasses RLS entirely.
# Server-only, and only for admin work: migrations, the scheduled retention
# purge, and deleting an auth user during account erasure.
#
# It must never appear in a user-facing query. If you find it imported outside
# lib/infrastructure/supabase/admin.ts, that is a bug, not a shortcut.
# (This replaces the older `service_role` JWT key. Supabase also rejects secret
# keys sent from a browser User-Agent with a 401, which is a useful backstop
# but not a substitute for keeping it off the client.)
SUPABASE_SECRET_KEY=

# --- Anthropic -------------------------------------------------------------
# Create at console.anthropic.com. Set a spend cap on it.
ANTHROPIC_API_KEY=

# Pinned to a dated snapshot, not a moving alias like `claude-haiku-4-5`. An
# alias means the model can change under a build that already passed its tests,
# and the thing being tested here is honesty.
#
# Haiku is enough for this workload: it is rewording supplied text, not
# reasoning hard. Roughly $1 per million input tokens at time of writing.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Encryption ------------------------------------------------------------
# 32 bytes, base64. Generate with:  openssl rand -base64 32
# Encrypts the identity header (name, email, phone) at the application layer,
# so a stolen database dump yields ciphertext.
#
# Losing this makes every stored identity header unrecoverable. That is a
# feature from a breach standpoint and a problem from a backup standpoint.
ENCRYPTION_KEY=

# --- Site ------------------------------------------------------------------
# Used to build the OAuth redirect. http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
